{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xdownload",
  "main": "worker/worker.js",
  "compatibility_date": "2026-06-13",
  "observability": {
    "enabled": false
  },
  // Serve the Vite build output (public/ is gone; the app is now built). The
  // `build.command` below runs `vite build` before every `wrangler deploy` /
  // `wrangler dev`, so dist/ is never stale or missing.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "xdownload.info",
      "custom_domain": true
    }
  ]
}
